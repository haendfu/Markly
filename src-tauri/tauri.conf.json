{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markly",
  "version": "0.1.0",
  "identifier": "com.markly.app",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Markly",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "Markly Markdown",
        "description": "Markdown 文档",
        "role": "Editor"
      },
      {
        "ext": ["markdown"],
        "name": "Markly Markdown",
        "description": "Markdown 文档",
        "role": "Editor"
      },
      {
        "ext": ["mdown", "mkd"],
        "name": "Markly Markdown",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "./nsis/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
